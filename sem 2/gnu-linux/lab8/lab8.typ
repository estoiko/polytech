  [CPU (целочисл.)], [Sysbench], [1838,15 соб/с], [Типично для Atom-класса 4 ядра],
  [Сеть (loopback)], [Network Loopback], [54,64 с / 10 ГБ], [Ограничен CPU-производительностью],
